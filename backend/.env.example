PORT=3000

NODE_ENV=development

FRONTEND_URL=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_de_gastos
DB_USER=
DB_PASSWORD=

JWT_SECRET=

#Tiempo de expiracion del token
# Se deja unos minutos MAS LARGO que SESSION_IDLE_TIMEOUT_MINUTES a
# proposito: el verdadero limite de inactividad lo sigue aplicando el
# backend contra "last_activity_at" en PostgreSQL (ver auth.middleware.ts),
# no la fecha de vencimiento del JWT en si. Este margen evita que, si una
# sola notificacion de actividad (POST /api/auth/session/activity) se
# demora o falla por una red lenta, el usuario pierda la sesion en pleno
# uso solo porque el token crudo ya vencio, antes de que el backend
# hubiera considerado la sesion realmente inactiva.
JWT_EXPIRES_IN=20m

# Client ID de OAuth 2.0 (tipo "Aplicacion web") creado en Google Cloud
# Console para habilitar "Continuar con Google". Ver seccion del README
# sobre configuracion de Google Cloud para obtener este valor.
GOOGLE_CLIENT_ID=

# Control de sesion por inactividad (tabla "user_sessions").
# SESSION_IDLE_TIMEOUT_MINUTES: minutos sin actividad tras los cuales la
# sesion vence. JWT_EXPIRES_IN debe ser IGUAL O MAYOR a este valor (nunca
# menor), para que el JWT no venza antes de que el backend considere la
# sesion inactiva.
# SESSION_ABSOLUTE_TIMEOUT_HOURS: duracion maxima de una sesion, sin
# importar cuanta actividad haya habido.
#
# Valor normal (produccion):
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
#
# Para probar el vencimiento por inactividad en pocos segundos, cambia
# temporalmente (y solo en local):
# SESSION_IDLE_TIMEOUT_MINUTES=1
# JWT_EXPIRES_IN=2m
