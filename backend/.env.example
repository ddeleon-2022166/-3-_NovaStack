PORT=3000

NODE_ENV=development

FRONTEND_URL=http://localhost:4200

DB_HOST=localhost
DB_PORT=5432
DB_NAME=control_de_gastos
DB_USER=
DB_PASSWORD=

JWT_SECRET=

#Tiempo de expiracion del token
JWT_EXPIRES_IN=15m

# Client ID de OAuth 2.0 (tipo "Aplicacion web") creado en Google Cloud
# Console para habilitar "Continuar con Google". Ver seccion del README
# sobre configuracion de Google Cloud para obtener este valor.
GOOGLE_CLIENT_ID=

# Control de sesion por inactividad (tabla "user_sessions").
# SESSION_IDLE_TIMEOUT_MINUTES: minutos sin actividad tras los cuales la
# sesion vence. Debe coincidir con JWT_EXPIRES_IN para que el JWT no
# sobreviva mas tiempo del que la sesion permite estar inactiva.
# SESSION_ABSOLUTE_TIMEOUT_HOURS: duracion maxima de una sesion, sin
# importar cuanta actividad haya habido.
#
# Valor normal (produccion):
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
#
# Para probar el vencimiento por inactividad en pocos segundos, cambia
# temporalmente (y solo en local):
# SESSION_IDLE_TIMEOUT_MINUTES=1
# JWT_EXPIRES_IN=1m
